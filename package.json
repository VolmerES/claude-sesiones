{
  "name": "claude-sesiones",
  "version": "0.1.0",
  "description": "Browse and resume Claude Code conversations from every folder and every account, in the terminal",
  "type": "module",
  "bin": {
    "cses": "./dist/cli.js",
    "claude-sesiones": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.es.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsx src/cli.tsx",
    "prepare": "npm run build",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "tui",
    "terminal",
    "sessions",
    "resume",
    "ink"
  ],
  "author": "VolmerES (fork of ccresume by sasazame)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VolmerES/claude-sesiones.git"
  },
  "homepage": "https://github.com/VolmerES/claude-sesiones#readme",
  "bugs": {
    "url": "https://github.com/VolmerES/claude-sesiones/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "clipboardy": "^5.3.2",
    "ink": "^5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "@types/react": "^18.2.48",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "jest": "^30.4.1",
    "ts-jest": "^29.4.9",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  }
}
